# Public site URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://merittalentacademy.com

# ---- Enquiry form delivery (configure ONE option) ----
# Until one of these is set, the contact form validates input
# but tell visitors their details were NOT sent and show META's email/phone.

# Option 1: POST each enquiry as JSON to a webhook (Zapier, Make, Formspree, CRM…)
ENQUIRY_WEBHOOK_URL=

# Option 2: send each enquiry by email through Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated recipient list, e.g. metacontactus@gmail.com
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "META Website <enquiries@merittalentacademy.com>"
ENQUIRY_FROM_EMAIL=
